{
  "name": "market-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test && pnpm test:db",
    "test:db": "vitest run --config supabase/tests/vitest.config.ts",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "cards": "tsx --env-file-if-exists=.env scripts/login-cards.ts",
    "verify-lottery": "tsx scripts/verify-lottery.ts",
    "new-seed": "tsx scripts/new-seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@msim/engine": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "pdf-lib": "^1.17.1"
  }
}
