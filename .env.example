# ── Web app (Vercel project env, or apps/web/.env.local for local dev) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key. It only grants what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Domain of the synthetic team login emails (no mail is ever sent). Must match TEAM_EMAIL_DOMAIN below.
NEXT_PUBLIC_TEAM_EMAIL_DOMAIN=teams.example.org

# Server-only (never prefixed NEXT_PUBLIC_). Used by the AI judge worker and the tick backup (later phases).
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Judge models (Phase 6, docs/JUDGE.md). See PLAN.md open question Q3 about temperature.
JUDGE_MODEL=claude-opus-5-5
JUDGE_BACKUP_MODEL=claude-sonnet-5-5
# Only set if the chosen model accepts a temperature parameter (claude-opus-5-5 and claude-sonnet-5-5 do not).
JUDGE_TEMPERATURE=
# output_config.effort for every judging call: low, medium, high, xhigh or max.
JUDGE_EFFORT=low
# Judging calls in parallel per worker (each open console, and pnpm judge-worker).
JUDGE_CONCURRENCY=8
# How long one POST /api/judge/work keeps claiming runs (ms).
JUDGE_WORK_BUDGET_MS=50000
# 1 = the deterministic fake judge instead of the model (rehearsal events only; refused on a live event).
JUDGE_FAKE=
JUDGE_FAKE_LATENCY_MS=300
# Optional: where prompts/ is, if it is not found by walking up from the working directory.
JUDGE_PROMPTS_DIR=

# ── Operator scripts (seed, login cards). Run on an organiser's machine, NOT on Vercel ──────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY (above) is also needed by the seed script and pnpm judge-worker (which also reads
# ANTHROPIC_API_KEY and the JUDGE_* settings above).
# Passwords are derived from this secret; anyone holding it can compute every team password.
CARD_SECRET=
TEAM_EMAIL_DOMAIN=teams.example.org
APP_URL=https://your-app.vercel.app
